{
  "name": "brgy-legaspi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:legacy-server\"",
    "predev:client": "node scripts/prepare-ocr-assets.js",
    "dev:client": "vite",
    "dev:api": "cd laravel-api && php artisan serve --host=0.0.0.0 --port=8000",
    "dev:legacy-server": "node --watch server.js",
    "start:legacy": "node server.js",
    "prebuild": "node scripts/prepare-ocr-assets.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/api.test.js tests/mau-and-mfa.test.js tests/mfa-key-rotation.test.js tests/payments.test.js tests/postgres-seeding.test.js tests/registry-csv.test.js tests/registry-scan.test.js tests/reminders.test.js tests/request-reporting.test.js tests/translations.test.js",
    "mfa:rotate-key": "node scripts/rotate-mfa-encryption.js",
    "staff:invite": "node scripts/create-staff-invitation.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
