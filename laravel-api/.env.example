APP_NAME="Barangay Legaspi API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For PostgreSQL use DATABASE_URL instead of DB_CONNECTION/DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

JWT_SECRET=
# Set during coordinated MFA key rotation; leave empty to read/write legacy v1 records.
MFA_ENCRYPTION_KEY=
# Temporary fallback during MFA key rollover; remove after every record is re-encrypted.
MFA_ENCRYPTION_KEY_PREVIOUS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESET_DELIVERY_URL=
NOTIFICATION_WEBHOOK_URL=
PUBLIC_CONTENT_API_BASE=https://barangaylegaspi.onrender.com/api

LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
