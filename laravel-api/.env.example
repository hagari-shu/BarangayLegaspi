APP_NAME="Barangay Legaspi API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For PostgreSQL use DATABASE_URL instead of DB_CONNECTION/DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

JWT_SECRET=
# Set during coordinated MFA key rotation; leave empty to read/write legacy v1 records.
MFA_ENCRYPTION_KEY=
# Temporary fallback during MFA key rollover; remove after every record is re-encrypted.
MFA_ENCRYPTION_KEY_PREVIOUS=
PUBLIC_APP_URL=
RESEND_API_KEY=
SUPER_ADMIN_INVITATION_FROM_EMAIL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESET_DELIVERY_URL=
NOTIFICATION_WEBHOOK_URL=
PUBLIC_CONTENT_API_BASE=https://barangaylegaspi.onrender.com/api

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
