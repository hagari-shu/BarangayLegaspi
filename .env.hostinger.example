# Copy to .env.hostinger on the VPS, chmod 600, and replace every placeholder.
# Keep database passwords hexadecimal (openssl rand -hex 32) so DATABASE_URL remains safe to parse.
PUBLIC_APP_URL=https://barangaylegaspi.tech
CORS_ORIGINS=https://barangaylegaspi.tech,https://www.barangaylegaspi.tech
POSTGRES_VERSION=16
# PostgreSQL 18+ needs its parent directory mounted; keep the default for PostgreSQL 16/17.
POSTGRES_DATA_DIR=/var/lib/postgresql/data

# Internal database administrator (not used by either application).
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-distinct-output-from-openssl-rand-hex-32

# Application database accounts. Do not reuse the database administrator credentials.
NODE_DB_NAME=barangay_node
NODE_DB_USER=barangay_node
NODE_DB_PASSWORD=replace-with-output-from-openssl-rand-hex-32
JWT_SECRET=replace-with-a-distinct-output-from-openssl-rand-hex-32
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=
DB_POOL_MAX=10

# Optional integrations. Configure only after each has been tested.
RESET_DELIVERY_URL=
RESET_DELIVERY_TOKEN=
NOTIFICATION_WEBHOOK_URL=
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
SUPER_ADMIN_INVITATION_FROM_EMAIL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# Isolated Laravel staging service, started only with --profile laravel-staging.
LARAVEL_DB_NAME=barangay_laravel
LARAVEL_DB_USER=barangay_laravel
LARAVEL_DB_PASSWORD=replace-with-another-output-from-openssl-rand-hex-32
LARAVEL_APP_KEY=base64:replace-with-base64-encoded-32-random-bytes
LARAVEL_JWT_SECRET=replace-with-a-distinct-output-from-openssl-rand-hex-32
LARAVEL_MFA_ENCRYPTION_KEY=
PUBLIC_CONTENT_API_BASE=https://barangaylegaspi.onrender.com/api
