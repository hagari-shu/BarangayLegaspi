# Copy to .env.hostinger on the VPS. Replace every placeholder before starting.
DOMAIN=portal.example.org
STAGING_ALLOWED_CIDR=203.0.113.10/32

POSTGRES_DB=barangay_legaspi
POSTGRES_USER=barangay_app
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password

# Generate APP_KEY with `php artisan key:generate --show`.
APP_KEY=base64:replace-with-a-generated-laravel-key
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters

# Used only if bootstrapping a genuinely new database; do not use this to
# create a second admin when importing an existing production database.
ADMIN_EMAIL=admin@example.org
ADMIN_MOBILE=replace-with-authorized-admin-mobile
ADMIN_PASSWORD=replace-with-a-unique-strong-initial-password

# Configure private object storage and password-reset delivery before enabling
# those workflows in production.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
RESET_DELIVERY_URL=
